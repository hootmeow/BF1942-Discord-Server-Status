# Discord Bot Token
DISCORD_TOKEN=your_bot_token_here

# PostgreSQL connection to bf1942-stats-engine database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bf1942
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# How often to refresh the status embed (milliseconds, minimum 15000)
POLL_INTERVAL_MS=60000

# BF1942 game server to show, as ip:query_port (must exist in the servers table)
BF1942_SERVER_ADDRESS=203.0.113.10:23000

# Discord channel the status embed is posted in
BF1942_CHANNEL_ID=123456789012345678

# Optional: override the embed title (default: live server name)
# BF1942_LABEL=My Server

# Optional: IANA timezone for the "Today" line — when today's peak and
# player/round counts reset (default: UTC)
# STATS_TIMEZONE=America/New_York
